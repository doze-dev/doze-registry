{
  "name": "doze-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The doze module registry: signed module data, served at registry.doze-dev.com and read by the doze CLI",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:remote": "node scripts/validate.mjs --remote",
    "keygen": "node scripts/keygen.mjs",
    "sign": "node scripts/sign.mjs",
    "publish": "node scripts/publish.mjs",
    "test:conformance": "bun scripts/conformance-check.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=doze-registry --branch=main",
    "domain-check": "sh scripts/domain-check.sh"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
